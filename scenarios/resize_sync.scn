# Resize the window all through a sync: after each size the screen is still
# one frame, never stacked, wrapped or scrolled, and the sync finishes anyway.
setup
on "BirdmanExe Drive/BirdmanExe"
on "BirdmanExe Drive/FractalWizz"
on "CSC Released Packs/A Bonus Gift Pack"
on "Guitar Hero/(2008) Guitar Hero On Tour"
launch
wait "Google Drive checked" 300
press S
wait "downloading" 120
resize 80x24
sleep 1.5
tidy
resize 60x20
sleep 1.5
tidy
resize 40x12
sleep 1.5
tidy
resize 30x8
sleep 1.5
tidy
resize 12x4
sleep 1.5
tidy
resize 140x40
sleep 1.5
tidy
# a drag: many sizes in a row, then it holds
resize 90x30
resize 50x14
resize 120x36
resize 36x10
resize 100x34
sleep 1.5
tidy
shot after-drag
wait "Finished in" 900
wait "Google Drive checked" 120
settled
quit
